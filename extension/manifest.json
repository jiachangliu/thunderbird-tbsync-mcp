{
  "manifest_version": 2,
  "name": "Thunderbird TbSync MCP",
  "version": "0.11.2",
  "description": "Scoped calendar reads and confirmed writes for TbSync v5 and EAS",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-tbsync-mcp@luthriel.dev",
      "strict_min_version": "153.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "experiment_apis": {
    "tbsyncMcpServer": {
      "schema": "mcp_server/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["tbsyncMcpServer"]],
        "script": "mcp_server/api.js"
      }
    }
  },
  "permissions": []
}
